# Copy to .env and adjust. .env is git-ignored; this file is committed.
NODE_ENV=development
PORT=4000
# The Next.js dev server — the only origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3000
# Local MySQL. URL-encode special characters in the password (@ → %40, # → %23).
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/changehub
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# How long a sign-in lasts.
SESSION_HOURS=8
# Failed logins allowed per account+address, and attempts per address, per 15 minutes.
LOGIN_MAX_FAILURES=10
LOGIN_MAX_PER_IP=100
# Proxies trusted to report the client IP (Express "trust proxy"). Add your reverse proxy's address.
TRUST_PROXY=loopback
# Where attachments are stored (relative to backend/). Back this folder up with the database.
UPLOAD_DIR=uploads
