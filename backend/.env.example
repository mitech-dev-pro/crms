# Copy to .env and adjust. .env is git-ignored; this file is committed.
NODE_ENV=development
PORT=4000
# The Next.js dev server — the only origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3000
# Local MySQL. URL-encode special characters in the password (@ → %40, # → %23).
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/changehub
